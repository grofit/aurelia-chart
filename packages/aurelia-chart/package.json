{
  "name": "aurelia-chart",
  "version": "2.0.1",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Aurelia 2 elements and attributes for Chart.js",
  "keywords": [
    "aurelia",
    "elements",
    "attributes",
    "charts"
  ],
  "homepage": "https://github.com/grofit/aurelia-chart",
  "bugs": {
    "url": "https://github.com/grofit/aurelia-chart/issues"
  },
  "license": "MIT",
  "author": "https://github.com/grofit",
  "contributors": [],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "typings": "dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grofit/aurelia-chart.git",
    "directory": "packages/aurelia-chart"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "npm run build:js && npm run build:types",
    "test": "vitest run",
    "publish:au2": "npm publish --tag au2"
  },
  "peerDependencies": {
    "aurelia": ">=2.0.0-rc.1",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "date-fns": "^4.4.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
