{
  "name": "aurelia-chart-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/aurelia-chart",
    "start": "npm run start -w packages/demo",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
